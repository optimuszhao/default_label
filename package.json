{
  "name": "weave-studio",
  "version": "0.10.0",
  "private": true,
  "description": "织影 Weave —— AI 文生图 / 图生图 / 文生视频 / 图生视频 / 长篇故事创作工作台",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --disable-warning=ExperimentalWarning --watch-path=server --watch-path=shared --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p server/tsconfig.json",
    "probe:comfy": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/probe-comfyweb.ts",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 'test/**/*.test.ts'",
    "fake:operator": "node --disable-warning=ExperimentalWarning scripts/fake-operator.ts",
    "test:e2e": "playwright test",
    "restore": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/restore.ts",
    "db": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/db.ts",
    "selfcheck": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env scripts/selfcheck.ts",
    "verify": "node --disable-warning=ExperimentalWarning scripts/verify.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "pino": "10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "zustand": "^5.0.15"
  }
}
