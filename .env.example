# 复制为 .env 后按需修改，或直接在启动命令前设置这些环境变量
PORT=8787
DATA_DIR=./data
# 生成的图片和视频单独存放的目录（默认 DATA_DIR/files）
MEDIA_DIR=

# mock：内置模拟服务
# comfyweb：朋友的 ComfyUI Web API（http://114.132.237.136:1025）
# http：按 docs/API_CONTRACT.md 实现的服务
PROVIDER=mock
GEN_API_BASE=
GEN_API_KEY=

# PROVIDER=comfyweb 时：对方分配的 API ID 和密钥（token 有效 72 小时，织影会自动续期）
COMFY_APPID=
COMFY_SECRET=
# 查询进度的间隔（毫秒），对方建议图片 3–5 秒、视频 10–15 秒
# COMFY_IMAGE_POLL_MS=4000
# COMFY_VIDEO_POLL_MS=12000

# AI 写作助手（大纲 / 台词 / 分镜）用的语言模型，任何 OpenAI 兼容接口，例如：
# LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1   LLM_MODEL=qwen-plus
# LLM_API_BASE=http://192.168.1.50:11434/v1                        LLM_MODEL=qwen2.5:14b （Ollama）
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# 超级管理员邮箱（逗号分隔），可以在设置页查看和刷新算子令牌
ADMIN_EMAILS=
# open 开放注册 / closed 关闭注册（ADMIN_EMAILS 里的邮箱仍可注册）
REGISTRATION=open

# 每天自动备份数据库的时间（留空关闭）和保留份数
BACKUP_AT=03:30
BACKUP_KEEP=7

# 同时提交给生成服务的任务数。对方会在 ComfyUI 里排队，设成 2~3 可以让图片不用等长视频跑完才提交
MAX_RUNNING=2
# 单任务超时：图片默认 30 分钟，视频（含转码和 2x 超分，通常 15–30 分钟）默认 90 分钟
# JOB_TIMEOUT_MS=1800000
# VIDEO_JOB_TIMEOUT_MS=5400000
